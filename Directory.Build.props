<Project>
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <OriginalTargetFramework>$(TargetFramework)</OriginalTargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DotNetLab</RootNamespace>
    <AssemblyName>DotNetLab.$([System.IO.Path]::GetFileName(`$(MSBuildProjectDirectory)`))</AssemblyName>
    <TestingPlatformShowTestsFailure>true</TestingPlatformShowTestsFailure>
    <Features>$(Features);use-roslyn-tokenizer=true</Features>
    <CompressionEnabled>false</CompressionEnabled>
    <LangVersion>preview</LangVersion>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <Deterministic>true</Deterministic>
    <ArtifactsPath Condition="'$(FileBasedProgram)' != 'true'">$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
    <SuppressNETCoreSdkPreviewMessage>true</SuppressNETCoreSdkPreviewMessage>
    <CustomAfterBlazorWebAssemblySdkTargets>$(MSBuildThisFileDirectory)eng\BlazorWasmIncrementalWorkaround.targets</CustomAfterBlazorWebAssemblySdkTargets>

    <!--
      Needed to get diagnostics inside XML doc comments.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1573;1591;0419</NoWarn>

    <!--
      Cannot trim because we dynamically execute programs
      which might depend on methods unreferenced at compile time.
    -->
    <PublishTrimmed>false</PublishTrimmed>
    <WasmNativeStrip>false</WasmNativeStrip>

    <!-- Needed to allow collecting GC traces. Only enabled in Release config to speed up dev loop. -->
    <EnableDiagnostics Condition="'$(Configuration)' == 'Release'">true</EnableDiagnostics>

    <!-- Disable runtime relinking and similar optimizations to speed up dev loop. -->
    <UsingBrowserRuntimeWorkload Condition="'$(Configuration)' != 'Release'">false</UsingBrowserRuntimeWorkload>

    <!--
      Suppress a warning like this one https://github.com/dotnet/runtime/issues/119317.
      Should be fine since we don't call that method which causes the warning.
      See also https://github.com/dotnet/runtime/issues/110870.
    -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);WASM0001</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <PropertyGroup Condition="'$(UseRuntimeAsync)' == 'true'">
    <Features>$(Features);runtime-async=on</Features>
  </PropertyGroup>

  <PropertyGroup>
    <DotNetLabUseCachingCompiler Condition="'$(DotNetLabUseCachingCompiler)' == '' and '$(CI)' != ''">false</DotNetLabUseCachingCompiler>
    <DotNetLabUseCachingCompiler Condition="'$(DotNetLabUseCachingCompiler)' == '' and '$(AndroidAttachDebugger)' == 'true'">false</DotNetLabUseCachingCompiler>
    <DotNetLabUseCachingCompiler Condition="'$(DotNetLabUseCachingCompiler)' == '' and '$(DotNetLabWatchBuild)' == 'true'">false</DotNetLabUseCachingCompiler>
    <DotNetLabUseCachingCompiler Condition="'$(DotNetLabUseCachingCompiler)' == ''">true</DotNetLabUseCachingCompiler>
  </PropertyGroup>
  <PropertyGroup Condition="'$(DotNetLabUseCachingCompiler)' == 'true'">
    <EnableSourceLink>false</EnableSourceLink>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Features>$(Features);use-global-cache</Features>
    <PathMap>$(MSBuildThisFileDirectory)=/_/</PathMap>
  </PropertyGroup>

  <PropertyGroup>
    <DotNetLabUseCompilerToolset Condition="'$(DotNetLabUseCompilerToolset)' == '' and '$(DotNetLabWatchBuild)' == 'true'">false</DotNetLabUseCompilerToolset>
  </PropertyGroup>
  <ItemGroup Condition="'$(DotNetLabUseCompilerToolset)' != 'false'">
    <PackageReference Include="Microsoft.Net.Compilers.Toolset">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Net.Compilers.Razor.Toolset"
                      Condition="'$(UsingMicrosoftNETSdkRazor)' == 'true'"
                      GeneratePathProperty="true">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="protobuf-net.BuildTools">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Roslyn.Diagnostics.Analyzers">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.Diagnostics" />
    <Using Include="System.Diagnostics.CodeAnalysis" />
    <Using Include="System.Collections.Immutable" />
    <Using Include="System.Globalization" />
    <Using Include="System.Net" />
    <Using Include="System.Reflection" />
    <Using Include="System.Text" />
    <Using Include="System.Text.RegularExpressions" />
  </ItemGroup>
</Project>
