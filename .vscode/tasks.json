{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "server: watch",
            "type": "process",
            "command": "dotnet",
            "args": [
                "watch",
                "--project",
                "src/Server",
                "--artifacts-path",
                "artifacts/watch",
                "/p:RunAnalyzers=false",
                "/p:DotNetLabWatchBuild=true"
            ],
            "options": {
                "env": {
                    "DOTNET_WATCH_RESTART_ON_RUDE_EDIT": "1"
                }
            },
            "isBackground": true,
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build"
            }
        },
        {
            "label": "wasm: watch",
            "type": "process",
            "command": "dotnet",
            "args": [
                "watch",
                "--project",
                "src/WebAssembly",
                "--artifacts-path",
                "artifacts/watch-wasm",
                "/p:RunAnalyzers=false",
                "/p:DotNetLabWatchBuild=true"
            ],
            "options": {
                "env": {
                    "DOTNET_WATCH_RESTART_ON_RUDE_EDIT": "1"
                }
            },
            "isBackground": true,
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "desktop: watch",
            "type": "process",
            "command": "dotnet",
            "args": [
                "watch",
                "--project",
                "src/Desktop",
                "--artifacts-path",
                "artifacts/watch-desktop",
                "/p:RunAnalyzers=false",
                "/p:DotNetLabWatchBuild=true"
            ],
            "options": {
                "env": {
                    "DOTNET_WATCH_RESTART_ON_RUDE_EDIT": "1"
                }
            },
            "isBackground": true,
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build"
            }
        },
    ]
}