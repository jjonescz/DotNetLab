@page "/not-found"
@layout MainLayout

<PageTitle>Page not found</PageTitle>

<div style="display:grid;place-items:center;height:100%;padding:2rem;text-align:center;">
    <div>
        <p class="lab-brand-title" style="font-size:2rem;">404</p>
        <p class="lab-setting-hint">The page you're looking for doesn't exist or has been moved.</p>
        <FluentAnchorButton Appearance="ButtonAppearance.Primary" Href="/">Go home</FluentAnchorButton>
    </div>
</div>
