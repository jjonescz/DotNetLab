<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BlazorMonaco" />
    <PackageReference Include="Fluxor.Blazor.Web" />
    <PackageReference Include="Fluxor.Blazor.Web.ReduxDevTools" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components" />
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components.Icons" />
    <PackageReference Include="PolyType" />
    <PackageReference Include="protobuf-net" />
    <PackageReference Include="System.IO.Hashing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Worker\Worker.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="..\..\eng\BuildTools\snapshots\*" LinkBase="snapshots" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.AspNetCore.Components" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Logging" />
    <Using Include="Microsoft.FluentUI.AspNetCore.Components.Utilities" />
  </ItemGroup>

  <ItemGroup>
    <NpmInput Include="Npm\**" Exclude="Npm\node_modules\**;Npm\package-lock.json" />
    <NpmOutput Include="wwwroot\js\jslib.js" />

    <!--
      Ignore content generated by npm as it's not picked up by clean builds anyway,
      only by rebuilds, but a rebuild immediately after a clean build wouldn't be incremental.
    -->
    <Content Remove="wwwroot\js\jslib.js*" />
    <None Remove="wwwroot\js\jslib.js*" />

    <!-- Mark as Content so it's included in `service-worker-assets.js`. -->
    <Content Include="@(NpmOutput)" />
  </ItemGroup>

  <Target Name="NpmBuild" BeforeTargets="PreBuildEvent" Inputs="@(NpmInput)" Outputs="@(NpmOutput)">
    <Exec Command="npm install" WorkingDirectory="Npm" />
    <Exec Command="npm run build" WorkingDirectory="Npm" />
    <!--
      Ensure the outputs are modified (even if Webpack did not touch them
      because the input changes were irrelevant to build output)
      so this target does not re-run unnecessarily.
    -->
    <Touch Files="@(NpmOutput)" AlwaysCreate="true" />
  </Target>

  <Target Name="AddLabIdentity" BeforeTargets="GetAssemblyAttributes" DependsOnTargets="PrepareForBuild">
    <PropertyGroup>
      <_LabRepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..'))</_LabRepoRoot>
    </PropertyGroup>
    <Exec Command="git rev-parse --short HEAD"
          WorkingDirectory="$(_LabRepoRoot)"
          ConsoleToMSBuild="true"
          IgnoreExitCode="true"
          StandardOutputImportance="Low"
          StandardErrorImportance="Low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_LabCommitRaw" />
    </Exec>
    <Exec Command="git log -1 --format=%25cI"
          WorkingDirectory="$(_LabRepoRoot)"
          ConsoleToMSBuild="true"
          IgnoreExitCode="true"
          StandardOutputImportance="Low"
          StandardErrorImportance="Low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_LabDateRaw" />
    </Exec>
    <PropertyGroup>
      <_LabCommit>$([System.Text.RegularExpressions.Regex]::Match('$(_LabCommitRaw)', '[0-9a-fA-F]{7,40}').Value)</_LabCommit>
      <_LabDateIso>$([System.Text.RegularExpressions.Regex]::Match('$(_LabDateRaw)', '[0-9]{4}-[0-9]{2}-[0-9]{2}').Value)</_LabDateIso>
      <_LabDate Condition="'$(_LabDateIso)' != ''">$([System.DateTime]::Parse('$(_LabDateIso)').ToString('yyyy.M.d'))</_LabDate>
    </PropertyGroup>
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>LabCommit</_Parameter1>
        <_Parameter2>$(_LabCommit)</_Parameter2>
      </AssemblyAttribute>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>LabDate</_Parameter1>
        <_Parameter2>$(_LabDate)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

</Project>
