@inherits FluxorComponent
@inject IState<CompilationOptionsState> Options
@inject IDispatcher Dispatcher

<FluentCheckbox Label="Declaration document" Value="Options.Value.ShowDeclarationDocument" ValueChanged="SetShowDeclarationDocument" />

@code {
    private void SetShowDeclarationDocument(bool value)
        => Dispatcher.Dispatch(new SetShowDeclarationDocumentAction(value));
}
