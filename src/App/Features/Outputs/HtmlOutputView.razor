@inherits FluxorComponent
@inject IState<DocumentMetadataState> DocumentsUi

@if (Outputs.ShowRenderedHtml && !DocumentsUi.Value.ActiveDocument.EndsWith(".cshtml", StringComparison.OrdinalIgnoreCase))
{
    <iframe @key="@("html-preview")"
            class="lab-html-preview"
            title="Rendered HTML"
            sandbox=""
            srcdoc="@Outputs.GetOutput(Output.Id)"></iframe>
}
else
{
    <TextOutputView />
}

@code {
    [CascadingParameter]
    public OutputWorkspace Outputs { get; set; } = default!;

    [CascadingParameter]
    public LabOutput Output { get; set; } = default!;
}
