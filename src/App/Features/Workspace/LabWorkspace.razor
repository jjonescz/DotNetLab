@inherits FluxorComponent
@inject LabWorkspaceState State
@inject EditorCursor Cursor
@inject IState<PreferencesState> Prefs
@inject IState<WorkspaceState> Layout
@inject IState<CompilationState> Compilation
@inject IState<CompilationOptionsState> Options
@inject IState<DocumentMetadataState> DocumentsUi
@inject IDispatcher Dispatcher
@inject IJSRuntime JS

<main @ref="_workspace"
      class="lab-workspace @(Prefs.Value.Stacked ? "stacked" : null) @(Prefs.Value.DisplayHintSquiggles ? null : "no-squiggly-hint")"
      style="@($"--pane-split: {Layout.Value.Split.ToString(System.Globalization.CultureInfo.InvariantCulture)}%")">
    @foreach (var paneId in new[] { "source", "output" })
    {
        var isPrimary = paneId == "source";
        <section class="lab-pane @(isPrimary ? "primary" : "secondary")">
            @if (paneId == "source")
            {
                <EditorGroups PaneId="source"
                              Items="DocumentsUi.Value.OpenNames"
                              Active="@DocumentsUi.Value.ActiveDocument"
                              ActiveChanged="OnSourceSelected"
                              ItemClosed="State.Documents.CloseFile"
                              ItemRenamed="OnSourceRenamed"
                              PinnedOrder="LabFixtures.SpecialSourceOrder"
                              Icon="@(new Icons.Regular.Size20.Code())">
                    <Actions>
                        <FluentButton Id="lab-source-format"
                                      Appearance="ButtonAppearance.Subtle"
                                      Size="ButtonSize.Small"
                                      IconOnly="true"
                                      Title="Format document"
                                      AriaLabel="Format document"
                                      IconStart="@(new Icons.Regular.Size20.TextEditStyle())"
                                      OnClick="State.FormatActiveSource" />
                        <FluentTooltip Anchor="lab-source-format"
                                       Class="lab-command-tooltip"
                                       Positioning="Positioning.Below"
                                       UseTooltipService="false">
                            Format document
                        </FluentTooltip>
                        <FluentMenu>
                            <FluentMenuButton Appearance="ButtonAppearance.Subtle"
                                              Size="ButtonSize.Small"
                                              IconOnly="true"
                                              Title="Add file"
                                              IconStart="@(new Icons.Regular.Size20.Add())" />
                            <FluentMenuList>
                                <FluentMenuItem IconStart="@(new Icons.Regular.Size20.Braces())"
                                                Label=".cs file"
                                                OnClick="@(() => State.Documents.AddFile(".cs"))" />
                                <FluentMenuItem IconStart="@(new Icons.Regular.Size20.Code())"
                                                Label=".razor file"
                                                OnClick="@(() => State.Documents.AddFile(".razor"))" />
                                <FluentMenuItem IconStart="@(new Icons.Regular.Size20.Globe())"
                                                Label=".cshtml file"
                                                OnClick="@(() => State.Documents.AddFile(".cshtml"))" />
                                <FluentDivider />
                                <FluentMenuItem IconStart="@(new Icons.Regular.Size20.NumberSymbol())"
                                                Label="Directives"
                                                OnClick="State.Documents.OpenDirectives" />
                                <FluentMenuItem IconStart="@(new Icons.Regular.Size20.DocumentSettings())"
                                                Label="Configuration"
                                                OnClick="State.Documents.OpenConfiguration" />
                            </FluentMenuList>
                        </FluentMenu>
                    </Actions>
                    <ItemLabel>
                        @if (context == LabFixtures.DirectivesFileName)
                        {
                            <FluentIcon Value="@(new Icons.Regular.Size20.NumberSymbol())" Width="16px" />
                            <span>Directives</span>
                        }
                        else if (context == LabFixtures.ConfigurationFileName)
                        {
                            <FluentIcon Value="@(new Icons.Regular.Size20.DocumentSettings())" Width="16px" />
                            <span>Configuration</span>
                        }
                        else
                        {
                            @context
                        }
                    </ItemLabel>
                    <ItemContent>
                        <LabCodeEditor @key="@($"source-{context}")"
                                       FileName="@context"
                                       Value="@State.Documents.Sources.GetValueOrDefault(context, "")"
                                       Language="@LabCatalog.LanguageFor(context)"
                                       ModelUri="@State.Documents.UriFor(context)"
                                       WordWrap="Prefs.Value.WordWrap"
                                       OnCursorChanged="OnCursorChanged"
                                       OnFocused="@(() => OnSourceSelected(context))" />
                    </ItemContent>
                </EditorGroups>
                <StatusBar Side="source" />
            }
            else
            {
                @if (State.WorkerError is { } workerError)
                {
                    <div class="lab-worker-error" role="alert">
                        <div class="lab-worker-error-title">Compiler worker failed.</div>
                        <div class="lab-worker-error-body">@workerError</div>
                        <FluentButton Size="ButtonSize.Small"
                                      Appearance="ButtonAppearance.Primary"
                                      IconStart="@(new Icons.Regular.Size20.ArrowSync())"
                                      OnClick="State.ReloadWorkerAsync">Re-create the worker</FluentButton>
                    </div>
                }
                <EditorGroups @ref="_outputGroups"
                              PaneId="output"
                              Items="State.Tabs.CurrentOutputTabIds"
                              Active="@State.Outputs.DisplayType"
                              ActiveChanged="OnOutputSelected"
                              ItemClosed="OnOutputClosed"
                              LockedItems="_lockedOutputTabs"
                              LayoutRevision="State.Tabs.Revision"
                              TabsChanged="OnOutputTabsChanged">
                    <Actions>
                        @{
                            var stripIds = OutputStripIds();
                            var addableTabs = State.Tabs.AddableOutputTabsFor(stripIds);
                        }
                        <FluentMenu>
                            <FluentMenuButton Appearance="ButtonAppearance.Subtle"
                                              Size="ButtonSize.Small"
                                              IconOnly="true"
                                              Title="Output tabs"
                                              IconStart="@(new Icons.Regular.Size20.Add())" />
                            <FluentMenuList>
                                @if (addableTabs.Count == 0)
                                {
                                    <FluentMenuItem Label="All tabs open" Disabled="true" />
                                }
                                else
                                {
                                    @foreach (var tab in addableTabs)
                                    {
                                        <FluentMenuItem Label="@($"Add {tab.Label}")"
                                                        OnClick="@(() => AddOutputTab(tab.Type))" />
                                    }
                                }
                                <FluentDivider />
                                <FluentMenuItem Label="Restore tab order"
                                                Disabled="@(!State.Tabs.OutputTabOrderDiffers(stripIds))"
                                                OnClick="RestoreOutputTabOrder" />
                                <FluentMenuItem Label="Restore closed tabs"
                                                Disabled="@(!State.Tabs.HasClosedOutputTabs(stripIds))"
                                                OnClick="RestoreClosedOutputTabs" />
                                <FluentDivider />
                                <FluentMenuItem Label="@($"Save for {LabCatalog.OutputKindLabel(LabCatalog.OutputKindFor(DocumentsUi.Value.ActiveDocument))}")"
                                                OnClick="SaveOutputTabsAsync" />
                            </FluentMenuList>
                        </FluentMenu>
                    </Actions>
                    <ItemLabel>
                        @if (context == "errors")
                        {
                            <span title="@State.Tabs.OutputTabTitle(context)" style="display:inline-flex;align-items:center;gap:6px;">
                                Error List
                                @if (Compilation.Value.HasDiagnosticCounts)
                                {
                                    <FluentBadge Appearance="BadgeAppearance.Filled"
                                                 Color="@(Compilation.Value.ErrorCount > 0 ? BadgeColor.Danger : BadgeColor.Warning)"
                                                 Size="BadgeSize.Tiny"
                                                 Content="@((Compilation.Value.ErrorCount > 0 ? Compilation.Value.ErrorCount : Compilation.Value.WarningCount).ToString())" />
                                }
                            </span>
                        }
                        else
                        {
                            <span title="@State.Tabs.OutputTabTitle(context)">@State.Tabs.OutputLabel(context)</span>
                        }
                    </ItemLabel>
                    <Toolbar>
                        @if (context == "tree")
                        {
                            <div class="lab-toolbar">
                                <FluentSelect TOption="SymbolDisplayKinds"
                                              TValue="SymbolDisplayKinds"
                                              Items="LabCatalog.SymbolDisplayKindOptions"
                                              OptionText="@(static (SymbolDisplayKinds kind) => LabCatalog.SymbolDisplayKindLabel(kind))"
                                              Value="Options.Value.ShowSymbols"
                                              ValueChanged="SetShowSymbols"
                                              AriaLabel="Symbols" />
                                <FluentCheckbox Label="Operations" Value="Options.Value.ShowOperations" ValueChanged="SetShowOperations" />
                                <FluentCheckbox Label="Bound nodes" Value="Options.Value.ShowBoundNodes" ValueChanged="SetShowBoundNodes" />
                            </div>
                        }
                        else if (context == "gcs")
                        {
                            <div class="lab-toolbar">
                                <FluentCheckbox Label="Declaration document" Value="Options.Value.ShowDeclarationDocument" ValueChanged="SetShowDeclarationDocument" />
                            </div>
                        }
                        else if (context == "html")
                        {
                            <div class="lab-toolbar">
                                <FluentCheckbox Label="Rendered" @bind-Value="_showRenderedHtml" />
                            </div>
                        }
                        else if (context == "il")
                        {
                            <div class="lab-toolbar">
                                <FluentCheckbox Label="Decode custom attribute blobs" Value="Options.Value.DecodeCustomAttributeBlobs" ValueChanged="SetDecodeCustomAttributeBlobs" />
                                <FluentCheckbox Label="Sequence points" Value="Options.Value.ShowSequencePoints" ValueChanged="SetShowSequencePoints" />
                                <FluentCheckbox Label="Full IL" Value="Options.Value.FullIl" ValueChanged="SetFullIl" />
                            </div>
                        }
                        else if (context == "errors")
                        {
                            <div class="lab-toolbar">
                                <FluentCheckbox Label="Exclude single file name" Value="Options.Value.ExcludeSingleFileNameInDiagnostics" ValueChanged="SetExcludeSingleFileNameInDiagnostics" />
                                <FluentCheckbox Label="Include hidden diagnostics" Value="Options.Value.IncludeHiddenDiagnostics" ValueChanged="SetIncludeHiddenDiagnostics" />
                            </div>
                        }
                    </Toolbar>
                    <ItemContent>
                        @if (context == "html" && _showRenderedHtml && !DocumentsUi.Value.ActiveDocument.EndsWith(".cshtml", StringComparison.OrdinalIgnoreCase))
                        {
                            <iframe @key="@("html-preview")"
                                    class="lab-html-preview"
                                    title="Rendered HTML"
                                    sandbox=""
                                    srcdoc="@State.Outputs.GetOutput("html")"></iframe>
                        }
                        else
                        {
                            var outputText = State.Outputs.GetOutput(context);
                            @if (State.Outputs.GetDisclaimer(context) == OutputDisclaimer.JitAsmUnavailableUsingCached)
                            {
                                <div class="lab-output-disclaimer" role="status">
                                    JIT disassembler is not available on this platform
                                    (it's only available in a <a href="@LabLinks.NativeApps" target="_blank" rel="noopener noreferrer">native app</a>).
                                    Displaying cached output.
                                </div>
                            }
                            <LabCodeEditor @key="@($"output-{context}")"
                                           Value="@outputText"
                                           Language="@State.Outputs.OutputLanguage(context)"
                                           ModelUri="@State.Outputs.OutputUriFor(context)"
                                           ReadOnly="true"
                                           WordWrap="Prefs.Value.WordWrap" />
                        }
                    </ItemContent>
                </EditorGroups>
                <StatusBar Side="output" />
            }
        </section>

        @if (isPrimary)
        {
            <div @ref="_splitter"
                 class="lab-splitter"
                 role="separator"
                 tabindex="0"
                 aria-label="Resize source and output panes"
                 aria-orientation="@(Prefs.Value.Stacked ? "horizontal" : "vertical")"
                 @onpointerdown="OnSplitterPointerDown"
                 @onpointerdown:preventDefault
                 @onpointerup="OnSplitterPointerUp"
                 @onpointercancel="OnSplitterPointerUp"
                 @onlostpointercapture="OnSplitterPointerUp"
                 @onkeydown="OnSplitterKeyDown"></div>
        }
    }
</main>

@code {
    private static readonly string[] _lockedOutputTabs = [LabCatalog.ErrorsOutputType];

    private EditorGroups? _outputGroups;
    private ElementReference _workspace;
    private ElementReference _splitter;
    private bool _resizing;
    private bool _showRenderedHtml;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        State.Changed += OnChanged;
    }

    protected override bool ShouldRender() => !_resizing;

    private void OnChanged()
    {
        if (!_resizing)
        {
            InvokeAsync(StateHasChanged);
        }
    }

    private void OnSourceSelected(string file)
    {
        if (string.Equals(DocumentsUi.Value.ActiveDocument, file, StringComparison.Ordinal))
        {
            return;
        }

        CaptureOutputStrip();
        State.Documents.SetActiveSource(file);
    }

    private void OnOutputClosed(string _)
    {
        CaptureOutputStrip();
        State.Tabs.EnsureActiveOutput();
        State.Notify();
    }

    private IReadOnlyList<string> OutputStripIds()
        => _outputGroups?.CurrentTabIds() is { Count: > 0 } ids
            ? ids
            : State.Tabs.CurrentOutputTabIds;

    private void CaptureOutputStrip()
        => State.Tabs.CaptureOpenOutputTabs(OutputStripIds());

    private void OnOutputTabsChanged(IReadOnlyList<string> ids)
        => State.Tabs.CaptureOpenOutputTabs(ids);

    private void AddOutputTab(string type)
    {
        CaptureOutputStrip();
        State.Tabs.AddOutputTab(type);
    }

    private void RestoreOutputTabOrder()
    {
        CaptureOutputStrip();
        State.Tabs.RestoreOutputTabOrder();
    }

    private void RestoreClosedOutputTabs()
    {
        CaptureOutputStrip();
        State.Tabs.RestoreClosedOutputTabs();
    }

    private async Task SaveOutputTabsAsync()
    {
        CaptureOutputStrip();
        State.Tabs.SaveOpenOutputTabsAsSettings();
        await State.PersistOutputTabsAsync();
    }

    private void OnSourceRenamed(TabRename rename)
        => State.Documents.RenameFile(rename.From, rename.To);

    private void OnOutputSelected(string tab)
    {
        State.ActiveOutput = tab;
        State.Notify();
    }

    private void SetShowSymbols(SymbolDisplayKinds value)
        => Dispatcher.Dispatch(new SetShowSymbolsAction(value));

    private void SetShowOperations(bool value)
        => Dispatcher.Dispatch(new SetShowOperationsAction(value));

    private void SetShowBoundNodes(bool value)
        => Dispatcher.Dispatch(new SetShowBoundNodesAction(value));

    private void SetShowDeclarationDocument(bool value)
        => Dispatcher.Dispatch(new SetShowDeclarationDocumentAction(value));

    private void SetDecodeCustomAttributeBlobs(bool value)
        => Dispatcher.Dispatch(new SetDecodeCustomAttributeBlobsAction(value));

    private void SetShowSequencePoints(bool value)
        => Dispatcher.Dispatch(new SetShowSequencePointsAction(value));

    private void SetFullIl(bool value)
        => Dispatcher.Dispatch(new SetFullIlAction(value));

    private void SetExcludeSingleFileNameInDiagnostics(bool value)
        => Dispatcher.Dispatch(new SetExcludeSingleFileNameInDiagnosticsAction(value));

    private void SetIncludeHiddenDiagnostics(bool value)
        => Dispatcher.Dispatch(new SetIncludeHiddenDiagnosticsAction(value));

    private void OnCursorChanged(CursorPositionChangedEvent args)
        => Cursor.Set(args.Position.LineNumber, args.Position.Column);

    private async Task OnSplitterPointerDown(PointerEventArgs args)
    {
        if (args.Button != 0)
        {
            return;
        }

        _resizing = true;
        try
        {
            await JS.InvokeVoidAsync(
                "netLabLayout.beginSplit",
                _workspace,
                _splitter,
                args.PointerId,
                args.ClientX,
                args.ClientY);
        }
        catch (JSException)
        {
            _resizing = false;
        }
    }

    private async Task OnSplitterPointerUp(PointerEventArgs args)
    {
        if (!_resizing)
        {
            return;
        }

        _resizing = false;
        double? percent = null;
        try
        {
            percent = await JS.InvokeAsync<double?>("netLabLayout.endSplit", _workspace, _splitter);
        }
        catch (JSException)
        {
        }

        if (percent is { } value)
        {
            SetSplit(value);
        }

        await InvokeAsync(StateHasChanged);
    }

    private void OnSplitterKeyDown(KeyboardEventArgs args)
    {
        var delta = args.Key is "ArrowLeft" or "ArrowUp" ? -2 : args.Key is "ArrowRight" or "ArrowDown" ? 2 : 0;
        if (delta != 0)
        {
            SetSplit(Layout.Value.Split + delta);
        }
    }

    private void SetSplit(double value)
    {
        if (Math.Abs(value - Layout.Value.Split) < 0.05)
        {
            return;
        }

        Dispatcher.Dispatch(new SetSplitAction(value));
    }

    protected override ValueTask DisposeAsyncCore(bool disposing)
    {
        if (disposing)
        {
            State.Changed -= OnChanged;
        }

        return base.DisposeAsyncCore(disposing);
    }
}
