@inject IJSRuntime JS
@inject EditorDragState Drag
@implements IDisposable
@implements IHandleEvent

<div class="lab-groups @(_orientation == "vertical" ? "vertical" : "horizontal")"
     data-lab-pane="@PaneId">
    @foreach (var group in _groups)
    {
        <div class="lab-group @(IsGroupFocused(group) ? "lab-group-focused" : null)">
            <div class="lab-tabbar">
                <div class="lab-tab-list"
                     @ondragover:preventDefault
                     @ondrop:preventDefault
                     @ondrop="() => DropOnList(group)">
                    @foreach (var (item, index) in UserTabs(group))
                    {
                        @if (_renaming == item)
                        {
                            <div @key="item"
                                 class="@TabClass(group, item, editing: true)"
                                 data-lab-tab="@item"
                                 data-lab-group="@group.Id"
                                 data-lab-pane="@PaneId">
                                @if (Icon is not null && PaneId == "source")
                                {
                                    <FluentIcon Value="@Icon" Width="16px" />
                                }
                                <input @ref="_renameInput"
                                       class="lab-tab-rename"
                                       value="@_renameDraft"
                                       size="@Math.Max(6, _renameDraft.Length + 1)"
                                       spellcheck="false"
                                       autocomplete="off"
                                       aria-label="Rename file"
                                       onfocus="this.select()"
                                       @oninput="OnRenameInput"
                                       @onkeydown="OnRenameKeyAsync"
                                       @onblur="CommitRenameAsync"
                                       @onclick:stopPropagation
                                       @onmousedown:stopPropagation />
                            </div>
                        }
                        else
                        {
                            <button type="button"
                                    @key="item"
                                    class="@TabClass(group, item)"
                                    draggable="true"
                                    data-lab-tab="@item"
                                    data-lab-group="@group.Id"
                                    data-lab-pane="@PaneId"
                                    onmousedown="if (event.detail > 1) { this.draggable = false; event.preventDefault(); }"
                                    @onclick="@(() => SelectAsync(group.Id, item))"
                                    @ondblclick="@(() => BeginRenameAsync(group.Id, item))"
                                    @ondblclick:preventDefault
                                    @ondragstart="args => StartTabDrag(args, group.Id, item)"
                                    @ondragend="EndDrag"
                                    @ondragover:preventDefault
                                    @ondrop:preventDefault
                                    @ondrop="@(() => DropOnTab(group.Id, index))">
                                @if (Icon is not null && PaneId == "source")
                                {
                                    <FluentIcon Value="@Icon" Width="16px" />
                                }
                                @if (ItemLabel is not null)
                                {
                                    @ItemLabel(item)
                                }
                                else
                                {
                                    @item
                                }
                                @if (CanCloseItem(item))
                                {
                                    <span class="lab-tab-close"
                                          title="@($"Close {item}")"
                                          role="presentation"
                                          @onclick:stopPropagation
                                          @ondblclick:stopPropagation
                                          @onmousedown:stopPropagation
                                          @onclick="@(() => CloseTabAsync(group.Id, item))">
                                        <FluentIcon Value="@(new Icons.Regular.Size20.Dismiss())" Width="12px" />
                                    </span>
                                }
                            </button>
                        }
                    }
                </div>
                @{
                    var pins = PinnedTabs(group).ToList();
                }
                @if (pins.Count > 0)
                {
                    <div class="lab-tab-pins">
                        @foreach (var item in pins)
                        {
                            <button type="button"
                                    @key="item"
                                    class="@TabClass(group, item, pin: true)"
                                    data-lab-tab="@item"
                                    data-lab-group="@group.Id"
                                    data-lab-pane="@PaneId"
                                    @onclick="@(() => SelectAsync(group.Id, item))">
                                @if (ItemLabel is not null)
                                {
                                    @ItemLabel(item)
                                }
                                else
                                {
                                    @item
                                }
                                @if (CanCloseItem(item))
                                {
                                    <span class="lab-tab-close"
                                          title="@($"Close {item}")"
                                          role="presentation"
                                          @onclick:stopPropagation
                                          @onmousedown:stopPropagation
                                          @onclick="@(() => CloseTabAsync(group.Id, item))">
                                        <FluentIcon Value="@(new Icons.Regular.Size20.Dismiss())" Width="12px" />
                                    </span>
                                }
                            </button>
                        }
                    </div>
                }
                @if (Actions is not null && group == _groups[0])
                {
                    <div class="lab-tab-actions" @onclick:stopPropagation>
                        @Actions
                    </div>
                }
            </div>

            @if (Toolbar is not null)
            {
                @Toolbar(group.Active)
            }

            <div class="lab-group-body" @onpointerdown="@(() => ActivateGroupAsync(group))">
                @if (ItemContent is not null)
                {
                    @ItemContent(group.Active)
                }
                <div class="lab-drop-overlay"
                     @ondragover:preventDefault
                     @ondrop:preventDefault
                     @ondrop="args => DropOnBody(args, group)">
                    <div class="lab-drop-zone"></div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private sealed class Group
    {
        public required string Id { get; set; }
        public required List<string> Items { get; set; }
        public required string Active { get; set; }
    }

    private sealed class JsDrag
    {
        public string? Kind { get; set; }
        public string? Pane { get; set; }
        public string? Group { get; set; }
        public string? Value { get; set; }
    }

    [Parameter] public string PaneId { get; set; } = "";
    [Parameter] public IReadOnlyList<string> Items { get; set; } = [];
    [Parameter] public string Active { get; set; } = "";
    [Parameter] public EventCallback<string> ActiveChanged { get; set; }
    [Parameter] public Icon? Icon { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public RenderFragment<string>? ItemLabel { get; set; }
    [Parameter] public RenderFragment<string>? ItemContent { get; set; }
    [Parameter] public RenderFragment<string>? Toolbar { get; set; }
    [Parameter] public EventCallback<string> ItemClosed { get; set; }
    [Parameter] public EventCallback<TabRename> ItemRenamed { get; set; }
    [Parameter] public IReadOnlyList<string> PinnedOrder { get; set; } = [];
    [Parameter] public IReadOnlyList<string> LockedItems { get; set; } = [];
    [Parameter] public int LayoutRevision { get; set; }
    [Parameter] public EventCallback<IReadOnlyList<string>> TabsChanged { get; set; }

    private List<Group> _groups = [];
    private string _orientation = "vertical";
    private string? _renaming;
    private string _renameDraft = "";
    private ElementReference _renameInput;
    private bool _focusRename;
    private bool _committingRename;
    private string? _dragKind;
    private string? _dragPane;
    private string? _dragGroup;
    private string? _dragValue;
    private bool _initialized;
    private int _appliedLayoutRevision;

    protected override void OnInitialized() => Drag.Changed += OnSharedDrag;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusRename)
        {
            return;
        }

        _focusRename = false;
        try
        {
            await _renameInput.FocusAsync();
        }
        catch (JSException)
        {
        }
    }

    private void OnSharedDrag() => InvokeAsync(StateHasChanged);

    protected override void OnParametersSet()
    {
        if (!_initialized && Items.Count > 0)
        {
            _groups =
            [
                new Group
                {
                    Id = $"{PaneId}-1",
                    Items = Items.ToList(),
                    Active = string.IsNullOrWhiteSpace(Active) ? Items[0] : Active
                }
            ];
            _initialized = true;
            return;
        }

        if (!_initialized)
        {
            return;
        }

        if (LayoutRevision > _appliedLayoutRevision)
        {
            _appliedLayoutRevision = LayoutRevision;
            ReplaceGroupsFromItems();
            return;
        }

        SyncGroupsFromItems();
    }

    public IReadOnlyList<string> CurrentTabIds()
        => _groups.SelectMany(group => group.Items).ToArray();

    private bool CanCloseTabs => ItemClosed.HasDelegate && _groups.Sum(group => group.Items.Count) > 1;

    private bool IsLockedItem(string item)
        => LockedItems.Count > 0 && LockedItems.Contains(item);

    private bool CanCloseItem(string item)
        => CanCloseTabs && !IsLockedItem(item);

    private bool IsPinnedItem(string item)
        => PinnedOrder.Count > 0 && PinnedOrder.Contains(item);

    private IEnumerable<(string Item, int Index)> UserTabs(Group group)
        => group.Items.Select((item, index) => (item, index)).Where(entry => !IsPinnedItem(entry.item));

    private IEnumerable<string> PinnedTabs(Group group)
        => PinnedOrder.Count > 0
            ? PinnedOrder.Where(group.Items.Contains)
            : Enumerable.Empty<string>();

    private int LastUserInsertIndex(Group group)
    {
        var firstPinned = group.Items.FindIndex(IsPinnedItem);
        return firstPinned < 0 ? group.Items.Count : firstPinned;
    }

    private void SyncGroupsFromItems()
    {
        var known = Items.ToHashSet(StringComparer.Ordinal);
        foreach (var group in _groups)
        {
            group.Items.RemoveAll(item => !known.Contains(item));
            if (group.Items.Count > 0 && !group.Items.Contains(group.Active))
            {
                group.Active = group.Items[0];
            }
        }

        _groups = _groups.Where(group => group.Items.Count > 0).ToList();

        foreach (var item in Items)
        {
            if (_groups.All(group => !group.Items.Contains(item)))
            {
                if (_groups.Count == 0)
                {
                    _groups.Add(new Group
                    {
                        Id = $"{PaneId}-1",
                        Items = [item],
                        Active = item
                    });
                }
                else
                {
                    _groups[0].Items.Add(item);
                    _groups[0].Active = item;
                }
            }
        }

        if (string.IsNullOrWhiteSpace(Active))
        {
            return;
        }

        var owner = _groups.FirstOrDefault(group => group.Items.Contains(Active));
        if (owner is not null)
        {
            owner.Active = Active;
        }
    }

    Task IHandleEvent.HandleEventAsync(EventCallbackWorkItem callback, object? arg)
    {
        var task = callback.InvokeAsync(arg);
        if (arg is DragEventArgs)
        {
            return task.Status is TaskStatus.RanToCompletion or TaskStatus.Canceled
                ? Task.CompletedTask
                : AwaitDragAsync(task);
        }

        if (arg is PointerEventArgs)
        {
            return task.Status is TaskStatus.RanToCompletion or TaskStatus.Canceled
                ? Task.CompletedTask
                : AwaitDragAsync(task);
        }

        var shouldAwait = task.Status is not TaskStatus.RanToCompletion and not TaskStatus.Canceled;
        StateHasChanged();
        return shouldAwait ? AwaitRenderAsync(task) : Task.CompletedTask;
    }

    private static async Task AwaitDragAsync(Task task)
    {
        await task;
    }

    private async Task AwaitRenderAsync(Task task)
    {
        await task;
        StateHasChanged();
    }

    private void StartTabDrag(DragEventArgs args, string groupId, string value)
    {
        if (IsPinnedItem(value))
        {
            return;
        }

        args.DataTransfer.EffectAllowed = "move";
        _dragKind = "tab";
        _dragPane = PaneId;
        _dragGroup = groupId;
        _dragValue = value;
        Drag.Begin("tab", PaneId, groupId, value);
    }

    private void EndDrag()
    {
        _dragKind = null;
        _dragPane = null;
        _dragGroup = null;
        _dragValue = null;
        _ = EndDropVisualAsync();
        Drag.Clear();
    }

    private async Task EndDropVisualAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("netLabLayout.endDrop");
        }
        catch (JSException)
        {
        }
    }

    private async Task<(string Kind, string? Pane, string? Group, string? Value)> ReadDragAsync()
    {
        try
        {
            var js = await JS.InvokeAsync<JsDrag>("netLabLayout.currentDrag");
            if (js?.Kind is { Length: > 0 } kind)
            {
                return (kind, js.Pane, js.Group, js.Value);
            }
        }
        catch (JSException)
        {
        }

        return (
            Drag.Kind ?? _dragKind ?? "",
            Drag.Pane ?? _dragPane,
            Drag.Group ?? _dragGroup,
            Drag.Value ?? _dragValue);
    }

    private async Task<DropZone> ZoneAtAsync(double clientX, double clientY)
    {
        try
        {
            var name = await JS.InvokeAsync<string>("netLabLayout.dropZone", clientX, clientY);
            return name switch
            {
                "left" => DropZone.Left,
                "right" => DropZone.Right,
                "top" => DropZone.Top,
                "bottom" => DropZone.Bottom,
                _ => DropZone.Center
            };
        }
        catch (JSException)
        {
            return DropZone.Center;
        }
    }

    private void ReplaceGroupsFromItems()
    {
        if (Items.Count == 0)
        {
            _groups = [];
            return;
        }

        var active = !string.IsNullOrWhiteSpace(Active) && Items.Contains(Active)
            ? Active
            : Items[0];
        _groups =
        [
            new Group
            {
                Id = _groups.FirstOrDefault()?.Id ?? $"{PaneId}-1",
                Items = Items.ToList(),
                Active = active
            }
        ];
    }

    private async Task CloseTabAsync(string groupId, string value)
    {
        if (!CanCloseItem(value))
        {
            return;
        }

        var group = _groups.FirstOrDefault(item => item.Id == groupId);
        if (group is null || !group.Items.Contains(value))
        {
            return;
        }

        var wasActive = group.Active == value;
        group.Items.Remove(value);
        if (wasActive)
        {
            group.Active = group.Items.FirstOrDefault() ?? value;
        }

        _groups = _groups.Where(item => item.Items.Count > 0).ToList();
        await ItemClosed.InvokeAsync(value);

        if (wasActive && _groups.Count > 0)
        {
            var next = _groups.FirstOrDefault(item => item.Id == groupId) ?? _groups[0];
            await ActiveChanged.InvokeAsync(next.Active);
        }
    }

    private Task NotifyTabsAsync()
        => TabsChanged.HasDelegate
            ? TabsChanged.InvokeAsync(CurrentTabIds())
            : Task.CompletedTask;

    private bool IsGroupFocused(Group group)
        => string.Equals(Active, group.Active, StringComparison.Ordinal);

    private string TabClass(Group group, string item, bool pin = false, bool editing = false)
    {
        var selected = string.Equals(group.Active, item, StringComparison.Ordinal);
        var focused = string.Equals(Active, item, StringComparison.Ordinal);
        return "lab-tab"
            + (pin ? " lab-tab-pin" : null)
            + (selected ? " selected" : null)
            + (focused ? " focused" : null)
            + (editing ? " lab-tab-editing" : null);
    }

    private Task ActivateGroupAsync(Group group)
        => string.Equals(Active, group.Active, StringComparison.Ordinal)
            ? Task.CompletedTask
            : ActiveChanged.InvokeAsync(group.Active);

    private async Task SelectAsync(string groupId, string value)
    {
        var group = _groups.First(item => item.Id == groupId);
        group.Active = value;
        await ActiveChanged.InvokeAsync(value);
    }

    private async Task BeginRenameAsync(string groupId, string item)
    {
        if (!ItemRenamed.HasDelegate || IsPinnedItem(item) || _renaming == item)
        {
            return;
        }

        await SelectAsync(groupId, item);
        _renaming = item;
        _renameDraft = item;
        _focusRename = true;
    }

    private void OnRenameInput(ChangeEventArgs args)
        => _renameDraft = args.Value?.ToString() ?? "";

    private async Task OnRenameKeyAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await CommitRenameAsync();
        }
        else if (args.Key == "Escape")
        {
            CancelRename();
        }
    }

    private void CancelRename()
    {
        _renaming = null;
        _renameDraft = "";
        _focusRename = false;
    }

    private async Task CommitRenameAsync()
    {
        if (_committingRename || _renaming is null)
        {
            return;
        }

        _committingRename = true;
        var from = _renaming;
        var to = _renameDraft.Trim();
        _renaming = null;
        _renameDraft = "";
        _focusRename = false;

        try
        {
            if (!CanApplyRename(from, to))
            {
                return;
            }

            var group = _groups.FirstOrDefault(item => item.Items.Contains(from));
            if (group is null)
            {
                return;
            }

            var index = group.Items.IndexOf(from);
            group.Items[index] = to;
            if (group.Active == from)
            {
                group.Active = to;
            }

            await ItemRenamed.InvokeAsync(new TabRename(from, to));
        }
        finally
        {
            _committingRename = false;
        }
    }

    private bool CanApplyRename(string from, string to)
    {
        if (string.IsNullOrWhiteSpace(to) ||
            string.Equals(from, to, StringComparison.Ordinal) ||
            to is "." or ".." ||
            to.IndexOfAny(Path.GetInvalidFileNameChars()) >= 0 ||
            !string.Equals(Path.GetFileName(to), to, StringComparison.Ordinal) ||
            IsPinnedItem(from) ||
            IsPinnedItem(to) ||
            Items.Contains(to))
        {
            return false;
        }

        return true;
    }

    private async Task DropOnTab(string groupId, int index)
    {
        var (kind, pane, fromGroup, value) = await ReadDragAsync();
        if (kind != "tab" || pane != PaneId || value is null || fromGroup is null)
        {
            EndDrag();
            return;
        }

        var at = index;
        try
        {
            if (await JS.InvokeAsync<bool>("netLabLayout.tabDropAfter"))
            {
                at = index + 1;
            }
        }
        catch (JSException)
        {
        }

        MoveTab(fromGroup, value, groupId, at);
        await SelectAsync(groupId, value);
        await NotifyTabsAsync();
        EndDrag();
    }

    private async Task DropOnList(Group group)
    {
        var (kind, pane, fromGroup, value) = await ReadDragAsync();
        if (kind != "tab" || pane != PaneId || value is null || fromGroup is null)
        {
            EndDrag();
            return;
        }

        MoveTab(fromGroup, value, group.Id, LastUserInsertIndex(group));
        await SelectAsync(group.Id, value);
        await NotifyTabsAsync();
        EndDrag();
    }

    private async Task DropOnBody(DragEventArgs args, Group group)
    {
        var (kind, pane, fromGroup, value) = await ReadDragAsync();
        var zone = await ZoneAtAsync(args.ClientX, args.ClientY);

        if (kind != "tab" || pane != PaneId || value is null || fromGroup is null)
        {
            EndDrag();
            return;
        }

        if (zone == DropZone.Center)
        {
            MoveTab(fromGroup, value, group.Id, LastUserInsertIndex(group));
            await SelectAsync(group.Id, value);
        }
        else
        {
            SplitTab(zone, value, fromGroup, group.Id);
            await ActiveChanged.InvokeAsync(value);
        }

        await NotifyTabsAsync();
        EndDrag();
    }

    private void MoveTab(string fromId, string value, string toId, int index)
    {
        if (IsPinnedItem(value))
        {
            return;
        }

        var source = _groups.FirstOrDefault(group => group.Id == fromId);
        var target = _groups.FirstOrDefault(group => group.Id == toId);
        if (source is null || target is null)
        {
            return;
        }

        source.Items.Remove(value);
        if (source.Active == value)
        {
            source.Active = source.Items.FirstOrDefault() ?? value;
        }

        var at = Math.Clamp(index, 0, LastUserInsertIndex(target));
        if (!target.Items.Contains(value))
        {
            target.Items.Insert(at, value);
        }

        target.Active = value;
        _groups = _groups.Where(group => group.Items.Count > 0).ToList();
    }

    private void SplitTab(DropZone zone, string value, string fromId, string toId)
    {
        if (IsPinnedItem(value))
        {
            return;
        }

        var source = _groups.FirstOrDefault(group => group.Id == fromId);
        var target = _groups.FirstOrDefault(group => group.Id == toId);
        if (source is null || target is null)
        {
            return;
        }

        if (source.Id == target.Id && source.Items.Count < 2)
        {
            return;
        }

        source.Items.Remove(value);
        if (source.Active == value)
        {
            source.Active = source.Items.FirstOrDefault() ?? value;
        }

        _orientation = zone is DropZone.Top or DropZone.Bottom ? "vertical" : "horizontal";

        Group created;
        if (source.Items.Count == 0)
        {
            source.Items.Add(value);
            source.Active = value;
            created = source;
        }
        else
        {
            created = new Group
            {
                Id = $"{PaneId}-{DateTime.UtcNow.Ticks}",
                Items = [value],
                Active = value
            };
        }

        var remaining = _groups.Where(group => group.Items.Count > 0).ToList();
        remaining.Remove(created);

        var index = remaining.FindIndex(group => group.Id == target.Id);
        if (index < 0)
        {
            index = remaining.Count;
        }

        if (zone is DropZone.Top or DropZone.Left)
        {
            remaining.Insert(index, created);
        }
        else
        {
            remaining.Insert(Math.Min(index + 1, remaining.Count), created);
        }

        _groups = remaining;
    }

    public void Dispose() => Drag.Changed -= OnSharedDrag;
}
