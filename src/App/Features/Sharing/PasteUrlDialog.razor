@inherits FluxorComponent
@inject ShareUrlSync Urls
@inject IState<PasteUrlDialogState> Ui
@inject IDispatcher Dispatcher
@inject IJSRuntime JS

<FluentDialog @ref="_dialog" Class="lab-paste-dialog" Modal="true" OnStateChange="OnDialogStateChange">
    <FluentDialogBody>
        <TitleTemplate>Load from URL</TitleTemplate>
        <TitleActionTemplate>
            <FluentButton Appearance="ButtonAppearance.Outline"
                          Size="ButtonSize.Small"
                          IconOnly="true"
                          Title="Close"
                          IconStart="@(new Icons.Regular.Size20.Dismiss())"
                          OnClick="RequestClose" />
        </TitleActionTemplate>
        <ActionTemplate>
            <FluentButton Appearance="ButtonAppearance.Outline" OnClick="RequestClose">Cancel</FluentButton>
            <FluentButton Appearance="ButtonAppearance.Primary" Disabled="@string.IsNullOrWhiteSpace(_text)" OnClick="LoadAsync">Load</FluentButton>
        </ActionTemplate>
        <ChildContent>
            <div class="lab-paste-body">
                <p class="lab-setting-hint">Paste a .NET Lab link.</p>
                <FluentTextArea @bind-Value="_text"
                                Rows="3"
                                AriaLabel="URL"
                                Placeholder="https://…#…" />
            </div>
        </ChildContent>
    </FluentDialogBody>
</FluentDialog>

@code {
    private FluentDialog? _dialog;
    private string _text = "";
    private bool _shown;
    private bool _hiding;
    private bool _opening;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        await SyncDialogAsync();
    }

    private async Task SyncDialogAsync()
    {
        var shouldOpen = Ui.Value.IsOpen;
        if (shouldOpen && !_shown)
        {
            await ShowAsync();
        }
        else if (!shouldOpen && _shown)
        {
            await HideAsync();
        }
    }

    private void RequestClose() => Dispatcher.Dispatch(new ClosePasteUrlAction());

    private async Task ShowAsync()
    {
        if (_dialog is null || _shown)
        {
            return;
        }

        _text = "";
        _shown = true;
        _opening = true;
        try
        {
            await _dialog.ShowAsync();
        }
        catch (JSException)
        {
            _shown = false;
        }
        finally
        {
            _opening = false;
        }
    }

    private async Task HideAsync()
    {
        if (_dialog is null || _hiding || !_shown)
        {
            return;
        }

        _hiding = true;
        try
        {
            await _dialog.HideAsync();
        }
        catch (JSException)
        {
        }
        finally
        {
            _shown = false;
            _hiding = false;
        }
    }

    private async Task OnDialogStateChange(DialogEventArgs args)
    {
        if (args.State != DialogState.Closed)
        {
            return;
        }

        if (_hiding || _opening || await IsNativeOpenAsync())
        {
            return;
        }

        _shown = false;
        if (Ui.Value.IsOpen)
        {
            Dispatcher.Dispatch(new ClosePasteUrlAction());
        }
    }

    private async Task<bool> IsNativeOpenAsync()
    {
        try
        {
            return await JS.InvokeAsync<bool>("netLabDialog.isOpen", ".lab-paste-dialog");
        }
        catch (JSException)
        {
            return false;
        }
    }

    private async Task LoadAsync()
    {
        var text = _text;
        RequestClose();
        await Urls.ApplySlugOrUrlAsync(text);
    }
}
