    private async Task PickLocalCompilerAsync(CompilerKind compilerKind)
    {
        var pickerId = compilerKind switch
        {
            CompilerKind.Roslyn => "roslyn-compiler",
            CompilerKind.Razor => "razor-compiler",
            _ => throw new ArgumentOutOfRangeException(nameof(compilerKind), compilerKind, null)
        };

        if (await FilePicker.PickDirectoryAsync(pickerId) is { } dir)
        {
            await Worker.TransferDirectoryHandleAsync(dir.HandleId);
            switch (compilerKind)
            {
                case CompilerKind.Roslyn:
                    await UseRoslynVersionAsync(dir.Specifier, BuildConfiguration.Debug);
                    break;
                case CompilerKind.Razor:
                    await UseRazorVersionAsync(dir.Specifier, BuildConfiguration.Debug);
                    break;
            }
        }
    }

    private async Task SetLuminanceAsync(bool dark)
    {
        await BlazorMonaco.Editor.Global.SetTheme(JSRuntime, Page.GetMonacoTheme(dark: dark));
    }

    private async Task GoToConfigurationAsync()
    {
        await Page.SelectConfigurationAsync();
        CloseModal();
    }

    private async Task CheckForUpdatesAsync()
    {
        if (checkedForUpdates)
        {
            checkedForUpdates = false;
            await RefreshAsync();
        }

        await UpdateChecker.CheckForUpdatesAsync();
        checkedForUpdates = true;
    }

    private async Task LoadUpdateAsync(Action loadUpdate)
    {
        await Page.SaveStateToUrlAsync();
        loadUpdate();
    }
