@implements IDisposable
@inject ILogger<Settings> Logger
@inject IJSRuntime JSRuntime
@inject SettingsService SettingsService
@inject WorkerController Worker
@inject IUpdateChecker UpdateChecker
@inject IAppHostEnvironment HostEnvironment
@inject IFilePicker FilePicker

<FluentDesignTheme StorageName="theme" @bind-Mode="theme" CustomColor="@AppColors.CustomDark"
                   OnLoaded="(e) => SetLuminanceAsync(e.IsDark)" OnLuminanceChanged="(e) => SetLuminanceAsync(e.IsDark)" />

<FluentDialog @bind-Hidden="modalHidden" Modal="true" TrapFocus="true" PreventScroll="true"
              @ondialogdismiss="CloseModal" Style="--dialog-height: 100%">
    <FluentDialogHeader ShowDismiss="true" ShowDismissTooltip="false">
        <h2 style="font-size: 1.5em">Settings</h2>
    </FluentDialogHeader>

    <FluentDialogBody Style="overflow-y: auto; overflow-x: hidden; padding-bottom: 1em">
        <SettingsGroup>
            <ChildContent>
                @* Configuration file *@
                <SettingsButton Class="settings-nowarp" OnClick="GoToConfigurationAsync" title="Open the configuration file">
                    <Icon>
                        <FluentIcon Color="Color.Neutral" Value="new Icons.Regular.Size20.DocumentSettings()" />
                    </Icon>
                    <Header>
                        <h4 class="unset">Configuration File</h4>
                    </Header>
                    <Description>
                        C# version, feature flags, and more
                    </Description>
                    <ActionIcon>
                        <FluentIcon Color="Color.Neutral" Value="new Icons.Regular.Size12.ChevronRight()" />
                    </ActionIcon>
                </SettingsButton>

                @* Word wrap check box *@
                <SettingsCard Class="settings-nowarp">
                    <Icon>
                        <FluentIcon Color="Color.Neutral" Value="new Icons.Regular.Size20.TextWrap()" />
                    </Icon>
                    <Header>
                        <h4 class="unset">
                            Word Wrap
                            <kbd style="margin-left: 0.5em" title="Keyboard shortcut (works only inside the editors)">Alt+Z</kbd>
                        </h4>
                    </Header>
                    <Description>
                        Wrap text in the editors.
                    </Description>
                    <ActionContent>
                        <FluentSwitch @bind-Value="SettingsService.WordWrap" @bind-Value:after="SettingsService.SaveAsync">
                            @(SettingsService.WordWrap ? "On" : "Off")
                        </FluentSwitch>
                    </ActionContent>
                </SettingsCard>

                @* Use VIM check box *@
                <SettingsCard Class="settings-nowarp">
                    <Icon>
                        <FluentIcon Color="Color.Neutral" Value="new Icons.Regular.Size20.Keyboard()" />
                    </Icon>
                    <Header>
                        <h4 class="unset">Use VIM</h4>
                    </Header>
                    <Description>
                        Use the VIM mode.
                    </Description>
                    <ActionContent>
                        <FluentSwitch @bind-Value="SettingsService.UseVim" @bind-Value:after="SettingsService.SaveAsync">
                            @(SettingsService.UseVim ? "On" : "Off")
                        </FluentSwitch>
                    </ActionContent>
                </SettingsCard>

                @* Advanced options (should not be changed often by users) *@
                <SettingsExpander>
                    <Icon>
                        <FluentIcon Color="Color.Neutral" Value="new Icons.Regular.Size20.DeveloperBoard()" />
                    </Icon>
                    <Header>
                        <h4 class="unset">Advanced</h4>
                    </Header>
                    <Description>
                        The advanced options.
                    </Description>
                    <ChildContent>
                        <div>
                            @* Language services check box *@
                            <SettingsCard Class="default-setting-expander-item settings-nowarp">
                                <Header>
                                    <h5 class="unset">Language Services</h5>
                                </Header>
                                <Description>
                                    Completions, live diagnostics (currently uses only the built-in compiler and default configuration).
                                </Description>
                                <ActionContent>
                                    <FluentSwitch @bind-Value="SettingsService.EnableLanguageServices" @bind-Value:after="SettingsService.SaveAsync">
                                        @(SettingsService.EnableLanguageServices ? "On" : "Off")
                                    </FluentSwitch>
                                </ActionContent>
                            </SettingsCard>

                            @* Debug logs check box *@
                            <SettingsCard Class="default-setting-expander-item settings-nowarp">
                                <Header>
                                    <h5 class="unset">Debug Logs</h5>
                                </Header>
                                <Description>
                                    Whether to display debug-level logs in the browser development console.
                                </Description>
                                <ActionContent>
                                    <FluentSwitch @bind-Value="SettingsService.DebugLogs" @bind-Value:after="SettingsService.SaveAsync">
                                        @(SettingsService.DebugLogs ? "On" : "Off")
                                    </FluentSwitch>
                                </ActionContent>
                            </SettingsCard>

                            @* Trace logs check box *@
                            <SettingsCard Class="default-setting-expander-item settings-nowarp">
                                <Header>
                                    <h5 class="unset">Trace Logs</h5>
                                </Header>
                                <Description>
                                    Whether to display trace-level logs in the browser development console.
                                </Description>
                                <ActionContent>
                                    <FluentSwitch @bind-Value="SettingsService.TraceLogs" @bind-Value:after="SettingsService.SaveAsync">
                                        @(SettingsService.TraceLogs ? "On" : "Off")
                                    </FluentSwitch>
                                </ActionContent>
                            </SettingsCard>

                            @* Memory usage view check box (currently works only in browser) *@
                            @if (OperatingSystem.IsBrowser())
                            {
                                <SettingsCard Class="default-setting-expander-item settings-nowarp">
                                    <Header>
                                        <h5 class="unset">Memory Usage View</h5>
                                    </Header>
                                    <Description>
                                        Whether to display info about memory usage (and a button to download GC traces) in the top right corner of the app.
                                    </Description>
                                    <ActionContent>
                                        <FluentSwitch @bind-Value="SettingsService.EnableMemoryUsageView" @bind-Value:after="SettingsService.SaveAsync">
                                            @(SettingsService.EnableMemoryUsageView ? "On" : "Off")
                                        </FluentSwitch>
                                    </ActionContent>
                                </SettingsCard>
                            }

                            @* Use a worker check box *@
                            @if (HostEnvironment.SupportsWebWorkers)
                            {
                                <SettingsCard Class="default-setting-expander-item settings-nowarp">
                                    <Header>
                                        <h5 class="unset">Compile in a background worker thread (requires restart)</h5>
                                    </Header>
                                    <Description>
                                        Moves compilation (and language services if enabled) to a separate worker thread (it is recommended to keep this enabled).
                                    </Description>
                                    <ActionContent>
                                        <FluentSwitch @bind-Value="SettingsService.EnableWorker" @bind-Value:after="SettingsService.SaveAsync">
                                            @(SettingsService.EnableWorker ? "On" : "Off")
                                        </FluentSwitch>
                                    </ActionContent>
                                </SettingsCard>

                                <SettingsCard Class="default-setting-expander-item settings-nowarp">
                                    <Header>
                                        <h5 class="unset">Worker stuck?</h5>
                                    </Header>
                                    <ActionContent>
                                        <FluentButton OnClick="Page.ReloadWorkerAsync"
                                                      IconStart="@(new Icons.Regular.Size16.ArrowClockwise())">Restart the worker</FluentButton>
                                    </ActionContent>
                                </SettingsCard>
                            }

                            @* Caching check box *@
                            <SettingsCard Class="default-setting-expander-item settings-nowarp">
                                <Header>
                                    <h5 class="unset">Enable Caching</h5>
                                </Header>
                                <Description>
                                    Cache inputs and outputs on a server for faster sharing.
                                </Description>
                                <ActionContent>
                                    <FluentSwitch @bind-Value="SettingsService.EnableCaching" @bind-Value:after="SettingsService.SaveAsync">
                                        @(SettingsService.EnableCaching ? "On" : "Off")
                                    </FluentSwitch>
                                </ActionContent>
                            </SettingsCard>

                            @* Auto compile on start check box *@
                            <SettingsCard Class="default-setting-expander-item settings-nowarp">
                                <Header>
                                    <h5 class="unset">Automatic Compilation</h5>
                                </Header>
                                <Description>
                                    Automatically begin compilation on start.
                                </Description>
                                <ActionContent>
                                    <FluentSwitch @bind-Value="SettingsService.AutoCompileOnStart" @bind-Value:after="SettingsService.SaveAsync">
                                        @(SettingsService.AutoCompileOnStart ? "On" : "Off")
                                    </FluentSwitch>
                                </ActionContent>
                            </SettingsCard>

                            @* Razor toolchain *@
                            <SettingsCard Class="default-setting-expander-item">
                                <Header>
                                    <h5 class="unset">Razor Toolchain</h5>
                                </Header>
                                <Description>
                                    Switch the Razor toolchain used for compilation.
                                </Description>
                                <ActionContent>
                                    <FluentSelect @bind-SelectedOption="RazorToolchain" @bind-SelectedOption:after="OnSetRazorToolchainAsync"
                                                  Items="Enum.GetValues<RazorToolchain>()" OptionText="RazorToolchainText" Style="min-width: 10em" />
                                </ActionContent>
                            </SettingsCard>

                            @* Razor strategy *@
                            <SettingsCard Class="default-setting-expander-item">
                                <Header>
                                    <h5 class="unset">Razor Strategy</h5>
                                </Header>
                                <Description>
                                    Switch the Razor strategy used for compilation.
                                </Description>
                                <ActionContent>
                                    <FluentSelect @bind-SelectedOption="RazorStrategy" @bind-SelectedOption:after="OnSetRazorStrategyAsync"
                                                  Items="Enum.GetValues<RazorStrategy>()" Style="min-width: 10em" />
                                </ActionContent>
                            </SettingsCard>
                        </div>
                    </ChildContent>
                </SettingsExpander>
            </ChildContent>
        </SettingsGroup>

        <SettingsGroup>
            <Header>
                <h3 class="unset">Compilers</h3>
            </Header>

            <ChildContent>
                @* SDK version select *@
                <SettingsCard Class="settings-keepwarp">
                    <Icon>
                        <FluentIcon Color="Color.Neutral" Value="new Icons.Regular.Size20.Box()" />
                    </Icon>
                    <Header>
                        <h4 class="unset">.NET SDK</h4>
                    </Header>
                    <Description>
                        Enter a .NET SDK version to automatically get
                        the corresponding Roslyn and Razor version numbers below.
                    </Description>
                    <ActionContent>
                        <FluentComboboxEx @bind-Value="sdkVersion" @bind-Value:after="() => LoadSdkInfoAsync()"
                                          Autocomplete="ComboboxAutocomplete.Both" Placeholder="version" Style="width: 100%">
                            @foreach (var info in sdkVersions ?? [])
                            {
                                <FluentOption TOption="string" Value="@info.Version">
                                    @info.Version
                                    @*
                                        For some reason, we cannot customize the text displayed in the closed combo box after selection
                                        and we don't want it to contain the additional info, so we use this as a workaround.
                                        `option-badge` is a CSS class which puts the `data-text` into `content` of `::after` pseudo-element.
                                    *@
                                    <span class="option-badge" data-text="@info.ReleaseDate"></span>
                                </FluentOption>
                            }
                            <FluentProgressRing slot="end" title="Loading info..." Visible="loadingSdkVersion != null" Width="1em" />
                        </FluentComboboxEx>
                        @if (sdkInfo != null)
                        {
                            <FluentLabel Style="margin-top: 8px">
                                SDK @(sdkInfo.SdkVersion)
                                @if (!sdkInfo.Commits.IsDefaultOrEmpty)
                                {
                                    @(" (")
                                    foreach (var (index, commit) in sdkInfo.Commits.Index())
                                    {
                                        if (index != 0)
                                        {
                                            @(" / ")
                                        }
                                        <CommitHashView Enabled="!modalHidden" Commit="commit" SaveKey="SdkCommitInfo" />
                                    }
                                    @(") ")
                                }
                                has roslyn @(sdkInfo.RoslynVersion)
                                and razor @(sdkInfo.RazorVersion).
                            </FluentLabel>
                        }
                        @if (sdkError != null)
                        {
                            <FluentLabel Color="Color.Error" Style="margin-top: 8px; white-space: pre-wrap">
                                @sdkError
                            </FluentLabel>
                        }
                    </ActionContent>
                </SettingsCard>

                @* Roslyn version select *@
                <SettingsCard Class="settings-keepwarp">
                    <Icon>
                        <FluentIcon Color="Color.Neutral" Value="new Icons.Regular.Size20.Box()" />
                    </Icon>
                    <Header>
                        <h4 class="unset">Roslyn</h4>
                    </Header>
                    <Description>
                        <SeeLinks Info="CompilerInfo.Roslyn" />
                        Use
                        @if (roslynVersion != "latest")
                        {
                            <a href="javascript:void" @onclick:preventDefault
                               @onclick="@(() => UseRoslynVersionAsync("latest"))">latest</a>
                        }
                        @if (roslynVersion != "main")
                        {
                            if (roslynVersion != "latest")
                            {
                                @(" or ")
                            }
                            <a href="javascript:void" @onclick:preventDefault
                               @onclick="@(() => UseRoslynVersionAsync("main"))">main</a>
                        }
                        @if (FilePicker.SupportsDirectoryPicker)
                        {
                            @(" or ")
                            <a href="javascript:void" @onclick:preventDefault
                               @onclick="@(() => PickLocalCompilerAsync(CompilerKind.Roslyn))">local</a>
                        }
                        @if (!string.IsNullOrWhiteSpace(roslynVersion))
                        {
                            @(" or ")
                            <a href="javascript:void" @onclick:preventDefault
                               @onclick="@(() => UseRoslynVersionAsync(null))">built-in</a>
                        }
                        @(".")
                    </Description>
                    <ActionContent>
                        <FluentStack>
                            <FluentTextField @bind-Value="roslynVersion" @bind-Value:after="() => LoadRoslynInfoAsync()"
                                             Placeholder="@VersionPlaceholder" Style="width: 100%">
                                <FluentProgressRing slot="end" title="Loading info..." Visible="loadingRoslynVersion != null" Width="1em" />
                            </FluentTextField>
                            <FluentSelect AriaLabel="@ConfigurationTip" Items="Enum.GetValues<BuildConfiguration>()"
                                          @bind-SelectedOption="roslynConfiguration" @bind-SelectedOption:after="() => LoadRoslynInfoAsync()"
                                          Style="min-width: 7em" />
                        </FluentStack>
                        <CompilerVersionInfo Settings="this" Compiler="CompilerInfo.Roslyn" Info="roslynInfo" Error="@roslynError" Style="margin-top: 8px" />
                    </ActionContent>
                </SettingsCard>

                @* Razor version select *@
                <SettingsCard Class="settings-keepwarp">
                    <Icon>
                        <FluentIcon Color="Color.Neutral" Value="new Icons.Regular.Size20.Box()" />
                    </Icon>
                    <Header>
                        <h4 class="unset">Razor</h4>
                    </Header>
                    <Description>
                        <SeeLinks Info="CompilerInfo.Razor" />
                        Use
                        @if (razorVersion != "latest")
                        {
                            <a href="javascript:void" @onclick:preventDefault
                               @onclick="@(() => UseRazorVersionAsync("latest"))">latest</a>
                        }
                        @if (razorVersion != "main")
                        {
                            if (razorVersion != "latest")
                            {
                                @(" or ")
                            }
                            <a href="javascript:void" @onclick:preventDefault
                               @onclick="@(() => UseRazorVersionAsync("main"))">main</a>
                        }
                        @if (FilePicker.SupportsDirectoryPicker)
                        {
                            @(" or ")
                            <a href="javascript:void" @onclick:preventDefault
                               @onclick="@(() => PickLocalCompilerAsync(CompilerKind.Razor))">local</a>
                        }
                        @if (!string.IsNullOrWhiteSpace(razorVersion))
                        {
                            @(" or ")
                            <a href="javascript:void" @onclick:preventDefault
                               @onclick="@(() => UseRazorVersionAsync(null))">built-in</a>
                        }
                        @(".")
                    </Description>
                    <ActionContent>
                        <FluentStack>
                            <FluentTextField @bind-Value="razorVersion" @bind-Value:after="() => LoadRazorInfoAsync()"
                                             Placeholder="@VersionPlaceholder" Style="width: 100%">
                                <FluentProgressRing slot="end" title="Loading info..." Visible="loadingRazorVersion != null" Width="1em" />
                            </FluentTextField>
                            <FluentSelect AriaLabel="@ConfigurationTip" Items="Enum.GetValues<BuildConfiguration>()"
                                          @bind-SelectedOption="razorConfiguration" @bind-SelectedOption:after="() => LoadRazorInfoAsync()"
                                          Style="min-width: 7em" />
                        </FluentStack>
                        <CompilerVersionInfo Settings="this" Compiler="CompilerInfo.Razor" Info="razorInfo" Error="@razorError" Style="margin-top: 8px" />
                    </ActionContent>
                </SettingsCard>
            </ChildContent>
        </SettingsGroup>

        @* About section *@
        <SettingsGroup>
            <Header>
                <h3 class="unset">About</h3>
            </Header>
            <ChildContent>
                <SettingsCard>
                    <Icon>
                        <FluentIcon Color="Color.Neutral" Value="new Icons.Regular.Size20.ArrowClockwise()" />
                    </Icon>
                    <Header>
                        <h4 class="unset">.NET Lab (<a href="@VersionUtil.CurrentCommit.RepoUrl" target="_blank" rel="noopener noreferrer">GitHub</a>)</h4>
                    </Header>
                    <Description>
                        <CommitHashView Enabled="!modalHidden" Commit="VersionUtil.CurrentCommit" SaveKey="commitInfo" TopLevelDateAndVersion />
                    </Description>
                    <ActionContent>
                        @* Check for updates *@
                        @if (UpdateChecker.Enabled)
                        {
                            <FluentButton OnClick="CheckForUpdatesAsync">Check for updates</FluentButton>
                        }
                    </ActionContent>
                </SettingsCard>
                @if (UpdateChecker.LoadUpdate is { } loadUpdate)
                {
                    <FluentMessageBar Title="An update is available." Intent="MessageIntent.Info" AllowDismiss="false">
                        To apply the update, all .NET Lab tabs need to be reloaded.
                        <FluentStack Style="margin-top: 0.5em" HorizontalAlignment="HorizontalAlignment.Stretch">
                            <FluentButton Appearance="Appearance.Accent" Style="width: 100%" OnClick="() => LoadUpdateAsync(loadUpdate)"
                                          IconStart="@(new Icons.Regular.Size16.ArrowClockwise())">Reload</FluentButton>
                            <FluentAnchor Href="@VersionUtil.CurrentCommit.ReleasesUrl" Target="_blank" Rel="noopener noreferrer" Style="width: 100%"
                                          IconStart="@(new Icons.Regular.Size16.DocumentBulletList())">Release notes</FluentAnchor>
                        </FluentStack>
                    </FluentMessageBar>
                }
                else if (UpdateChecker.UpdateIsDownloading)
                {
                    <FluentMessageBar Title="An update is being downloaded in the background." Intent="MessageIntent.Info" AllowDismiss="false">
                        <FluentProgressRing Width="1em" Style="display: inline-flex; margin-left: 0.5em" />
                    </FluentMessageBar>
                }
                else if (checkedForUpdates)
                {
                    <FluentMessageBar Title="No update found." Intent="MessageIntent.Info" AllowDismiss="false" />
                }

                @* Desktop app link *@
                @if (HostEnvironment.DesktopAppLink is { } desktopAppLink)
                {
                    <a href="@desktopAppLink.Url" target="_blank" rel="noopener noreferrer" style="text-decoration: none"
                       @onclick="desktopAppLink.OnClick == null ? null! : desktopAppLink.OnClick"
                       @onclick:preventDefault="desktopAppLink.OnClick != null">
                        <SettingsButton Class="settings-nowarp">
                            <Icon>
                                <FluentIcon Color="Color.Neutral" Value="new Icons.Regular.Size20.StoreMicrosoft()" />
                            </Icon>
                            <Header>
                                <h4 class="unset">@desktopAppLink.Title</h4>
                            </Header>
                            <Description>
                                @desktopAppLink.Description
                            </Description>
                            <ActionIcon>
                                <FluentIcon Color="Color.Neutral" Value="new Icons.Regular.Size12.ChevronRight()" />
                            </ActionIcon>
                        </SettingsButton>
                    </a>
                }

                @* Theme select *@
                <SettingsCard>
                    <Icon>
                        <FluentIcon Color="Color.Neutral" Value="new Icons.Regular.Size20.Color()" />
                    </Icon>
                    <Header>
                        <h4 class="unset">App Theme</h4>
                    </Header>
                    <Description>
                        Set the theme of this App.
                    </Description>
                    <ActionContent>
                        <FluentSelect Width="auto" Items="Enum.GetValues<DesignThemeModes>()" @bind-SelectedOption="theme"
                                      OptionText="@(x => $"{x} theme")" />
                    </ActionContent>
                </SettingsCard>
            </ChildContent>
        </SettingsGroup>
    </FluentDialogBody>
</FluentDialog>

@code {
    private static readonly string VersionPlaceholder = "version / PR / branch / build";

    public static readonly string ConfigurationTip = "Release configuration is always used for the built-in compilers and versions from NuGet.";

    private bool modalHidden = true;
    private DesignThemeModes theme;
    private string? sdkVersion, roslynVersion, razorVersion;
    private BuildConfiguration roslynConfiguration, razorConfiguration;
    private string? loadingSdkVersion, loadingRoslynVersion, loadingRazorVersion;
    private List<SdkVersionInfo>? sdkVersions;
    private SdkInfo? sdkInfo;
    private PackageDependencyInfo? roslynInfo, razorInfo;
    private Error? sdkError, roslynError, razorError;
    private bool checkedForUpdates;

    public readonly record struct Error(string Short, string Long)
    {
        private Error((string Short, string Long) tuple) : this(tuple.Short, tuple.Long) { }
        public Error(Exception ex) : this(ex is WorkerException w ? (w.Failure.Message, w.Failure.FullString) : (ex.Message, ex.ToString())) { }
    }

    [CascadingParameter] public required Page Page { get; set; }

    public DesignThemeModes Theme => theme;

    public bool ModalHidden => modalHidden;

    private RazorToolchain RazorToolchain { get; set; } = RazorToolchain.SourceGeneratorOrInternalApi;
    private RazorStrategy RazorStrategy { get; set; }

    private async Task OnSetRazorToolchainAsync()
    {
        Page.OnSettingsInputChanged();

        await Page.SaveStateToUrlAsync(state => state with
        {
            RazorToolchain = RazorToolchain,
        });
    }

    private async Task OnSetRazorStrategyAsync()
    {
        Page.OnSettingsInputChanged();

        await Page.SaveStateToUrlAsync(state => state with
        {
            RazorStrategy = RazorStrategy,
        });
    }

    private static string RazorToolchainText(RazorToolchain value)
    {
        return value switch
        {
            RazorToolchain.SourceGeneratorOrInternalApi => "Auto",
            RazorToolchain.SourceGenerator => "Source Generator",
            RazorToolchain.InternalApi => "Internal API",
            _ => value.ToString(),
        };
    }

    protected override async Task OnInitializedAsync()
    {
        await UpdateChecker.InitializeAsync();
        UpdateChecker.UpdateStatusChanged += StateHasChanged;
        StartWatching(SettingsService);

        // Load settings from local storage.
        await SettingsService.LoadIfNeededAsync();
    }

    void IDisposable.Dispose()
    {
        UpdateChecker.UpdateStatusChanged -= StateHasChanged;
        StopWatching(SettingsService);
    }

    public Task OpenModalAsync()
    {
        if (!modalHidden)
        {
            return Task.CompletedTask;
        }

        modalHidden = false;
        StateHasChanged();

        Task sdkVersionsTask = Task.CompletedTask;
        Task sdkTask = Task.CompletedTask;
        Task roslynTask = Task.CompletedTask;
        Task razorTask = Task.CompletedTask;

        if (sdkVersions is null)
        {
            sdkVersionsTask = LoadSdkVersionsAsync();
        }

        if (sdkInfo is null)
        {
            sdkTask = LoadSdkInfoAsync(saveState: false);
        }

        if (roslynInfo is null)
        {
            roslynTask = LoadRoslynInfoAsync(saveState: false);
        }

        if (razorInfo is null)
        {
            razorTask = LoadRazorInfoAsync(saveState: false);
        }

        return Task.WhenAll(sdkVersionsTask, sdkTask, roslynTask, razorTask);
    }

    public void CloseModal()
    {
        modalHidden = true;
    }

    internal Task LoadFromStateAsync(SavedState state)
    {
        RazorToolchain = state.RazorToolchain;
        RazorStrategy = state.RazorStrategy;
        StateHasChanged();

        Task sdkTask = Task.CompletedTask;
        Task roslynTask = Task.CompletedTask;
        Task razorTask = Task.CompletedTask;

        if (sdkVersion != state.SdkVersion)
        {
            sdkVersion = state.SdkVersion;
            sdkTask = LoadSdkInfoAsync(saveState: false);
        }

        if (roslynVersion != state.RoslynVersion ||
            roslynConfiguration != state.RoslynConfiguration)
        {
            roslynVersion = state.RoslynVersion;
            roslynConfiguration = state.RoslynConfiguration;
            roslynTask = LoadRoslynInfoAsync(saveState: false);
        }

        if (razorVersion != state.RazorVersion ||
            razorConfiguration != state.RazorConfiguration)
        {
            razorVersion = state.RazorVersion;
            razorConfiguration = state.RazorConfiguration;
            razorTask = LoadRazorInfoAsync(saveState: false);
        }

        return Task.WhenAll(sdkTask, roslynTask, razorTask);
    }

    private async Task LoadSdkVersionsAsync()
    {
        sdkVersions = await Worker.GetSdkVersionsAsync();
        await RefreshAsync();
    }

    private async Task LoadSdkInfoAsync(bool saveState = true)
    {
        var versionToLoad = sdkVersion;

        if (saveState)
        {
            await Page.SaveStateToUrlAsync(state => state with { SdkVersion = versionToLoad });
        }

        if (loadingSdkVersion != null && loadingSdkVersion == versionToLoad)
        {
            return;
        }

        loadingSdkVersion = versionToLoad;
        await RefreshAsync();

        SdkInfo? info;
        Error? error;
        try
        {
            if (string.IsNullOrEmpty(versionToLoad))
            {
                info = null;
                error = null;
            }
            else
            {
                info = modalHidden ? null : await Worker.GetSdkInfoAsync(versionToLoad);
                error = null;

                if (saveState)
                {
                    await Task.WhenAll(
                        UseRoslynVersionAsync(info?.RoslynVersion),
                        UseRazorVersionAsync(info?.RazorVersion));
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load SDK info.");
            error = new(ex);
            info = null;
        }

        if (sdkVersion == versionToLoad)
        {
            sdkInfo = info;
            sdkError = error;
        }

        loadingSdkVersion = null;
        await RefreshAsync();
    }

    private async Task UseSdkVersionAsync(string? version)
    {
        sdkVersion = version;
        await LoadSdkInfoAsync();
    }

    private async Task<(PackageDependencyInfo? Info, Error? Error)?> LoadCompilerInfoAsync(
        CompilerKind compilerKind,
        string? versionToLoad,
        BuildConfiguration configuration,
        bool saveState)
    {
        try
        {
            var changed = await Worker.UseCompilerVersionAsync(
                compilerKind,
                version: versionToLoad,
                configuration: configuration);

            if (!changed)
            {
                return null;
            }

            // `saveState` is `false` during initial load where we don't want to
            // display "output outdated" which would override the "cached" info.
            if (saveState)
            {
                Page.OnSettingsInputChanged();
            }

            var info = modalHidden
                ? null
                : await Worker.GetCompilerDependencyInfoAsync(compilerKind);

            return (info, null);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, $"Failed to load {compilerKind} info.");

            return (null, new(ex));
        }
    }

    private async Task LoadRoslynInfoAsync(bool saveState = true)
    {
        var versionToLoad = roslynVersion;

        if (saveState)
        {
            await Page.SaveStateToUrlAsync(state => state with
            {
                RoslynVersion = versionToLoad,
                RoslynConfiguration = roslynConfiguration,
            });
        }

        if (loadingRoslynVersion != null && loadingRoslynVersion == versionToLoad)
        {
            return;
        }

        loadingRoslynVersion = versionToLoad;
        await RefreshAsync();

        var result = await LoadCompilerInfoAsync(CompilerKind.Roslyn, versionToLoad, roslynConfiguration, saveState);

        if (result is var (info, error) && roslynVersion == versionToLoad)
        {
            roslynInfo = info;
            roslynError = error;
        }

        loadingRoslynVersion = null;
        await RefreshAsync();
    }

    private async Task UseRoslynVersionAsync(string? version, BuildConfiguration configuration = BuildConfiguration.Release)
    {
        roslynVersion = version;
        roslynConfiguration = configuration;
        await LoadRoslynInfoAsync();
    }

