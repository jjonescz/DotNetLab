<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="BlazorMonaco" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="protobuf-net" />
  </ItemGroup>

  <!-- IMPORTANT: Do not add references to Roslyn/Razor here. -->

  <ItemGroup>
    <PackageDownload Include="Microsoft.NETCore.App.Ref" Version="[$(NetCoreVersion)]" />
    <PackageDownload Include="Microsoft.AspNetCore.App.Ref" Version="[$(AspNetCoreVersion)]" />
    <_RefAssemblyToEmbed Include="$(NuGetPackageRoot)\microsoft.netcore.app.ref\$(NetCoreVersion)\ref\*\*.dll" />
    <_RefAssemblyToEmbed Include="$(NuGetPackageRoot)\microsoft.aspnetcore.app.ref\$(AspNetCoreVersion)\ref\*\*.dll" />
    <EmbeddedResource Include="@(_RefAssemblyToEmbed)" WithCulture="false" LogicalName="%(FileName)" Link="Ref/%(FileName)%(Extension)" />
  </ItemGroup>

  <Target Name="AddRefDocumentationResources" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <_RefDocumentationToEmbed Include="@(_RefAssemblyToEmbed->'%(RootDir)%(Directory)%(FileName).xml')" />
      <_RefDocumentationToEmbed Remove="@(_RefDocumentationToEmbed)" Condition="!Exists('%(FullPath)')" />
      <EmbeddedResource
        Include="@(_RefDocumentationToEmbed)"
        WithCulture="false"
        LogicalName="doc:%(FileName)"
        Link="RefDocs/%(FileName)%(Extension)" />
    </ItemGroup>
  </Target>
  
  <!-- BCL source generators. The analyzer: prefix keeps them out of RefAssemblies. -->

  <ItemGroup>
    <_SdkAnalyzerToEmbed Include="$(NuGetPackageRoot)\microsoft.netcore.app.ref\$(NetCoreVersion)\analyzers\dotnet\cs\*.dll" />
    <EmbeddedResource
      Include="@(_SdkAnalyzerToEmbed)"
      WithCulture="false"
      LogicalName="analyzer:%(FileName)"
      Link="Analyzers/%(FileName)%(Extension)" />
  </ItemGroup>

</Project>
