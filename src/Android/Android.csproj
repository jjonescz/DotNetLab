<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>$(OriginalTargetFramework)-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>

    <ApplicationTitle>.NET Lab</ApplicationTitle>
    <ApplicationId>me.janjones.dotnetlab</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
    <MauiAndroidSystemBarsUseMauiChrome>true</MauiAndroidSystemBarsUseMauiChrome>

    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">android-x64</RuntimeIdentifier>
  
    <PublishAot>false</PublishAot>
    <PublishReadyToRun>false</PublishReadyToRun>
    <BuildInParallel>false</BuildInParallel>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <AndroidLinkTool Condition="'$(Configuration)' == 'Release'">r8</AndroidLinkTool>

    <IndexHtmlScriptPath>_framework/blazor.webview.js</IndexHtmlScriptPath>
    <IndexHtmlHead><link rel="stylesheet" href="css/android.css" /><script src="blazor-webview-android-bridge.js"></script><script src="android-clipboard.js"></script></IndexHtmlHead>
    <IndexHtmlGoatcounterPath>/android</IndexHtmlGoatcounterPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
    <PackageReference Include="Microsoft.Maui.Controls" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\App\App.csproj" />
    <ProjectReference Include="..\CoreClr\CoreClr.csproj" />
  </ItemGroup>

  <!-- Android's inner build must not delete shared satellite assemblies needed by other apps. -->
  <ItemDefinitionGroup>
    <ProjectReference>
      <GlobalPropertiesToRemove>%(GlobalPropertiesToRemove);ResolveAssemblyReferencesFindRelatedSatellites</GlobalPropertiesToRemove>
    </ProjectReference>
  </ItemDefinitionGroup>

  <Import Project="..\..\eng\AppEntryPoint.targets" />

  <!-- The Android SDK currently generates JNI keep rules only for trimmed builds. -->
  <Target Name="GenerateUntrimmedProguardConfiguration"
          BeforeTargets="_CalculateProguardConfigurationFiles"
          DependsOnTargets="_ResolveAssemblies"
          Condition="'$(AndroidLinkTool)' == 'r8' and '$(PublishTrimmed)' != 'true'"
          Inputs="@(ResolvedAssemblies);$(MSBuildProjectFullPath)"
          Outputs="$(_ProguardProjectConfiguration)">
    <GenerateProguardConfiguration
        LinkedAssemblies="@(ResolvedAssemblies)"
        OutputFile="$(_ProguardProjectConfiguration)" />
    <ItemGroup>
      <FileWrites Include="$(_ProguardProjectConfiguration)" />
    </ItemGroup>
  </Target>

</Project>
