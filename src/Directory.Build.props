<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)..'))" />

  <ItemGroup>
    <ProjectReference
      Include="$(MSBuildThisFileDirectory)..\eng\BuildTools\BuildTools.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
      PrivateAssets="all"
      SetPlatform="Platform=AnyCPU">
      <Watch Condition="'$(DotNetLabWatchBuild)' == 'true'">false</Watch>
      <Targets Condition="'$(DotNetLabWatchBuild)' == 'true'">BuildForWatch</Targets>
    </ProjectReference>
  </ItemGroup>

</Project>
