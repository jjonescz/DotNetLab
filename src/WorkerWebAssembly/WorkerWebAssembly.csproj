<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OutputType>Exe</OutputType>
    <StaticWebAssetBasePath>worker</StaticWebAssetBasePath>
    <UsingBrowserRuntimeWorkload>false</UsingBrowserRuntimeWorkload>
    <WasmMainJSPath>wwwroot\main.js</WasmMainJSPath>
    <!-- Forwarded worker assets must not register a second Hot Reload agent in the UI runtime. -->
    <WasmEnableHotReload>false</WasmEnableHotReload>
    <WasmEmitTypeScriptDefinitions>true</WasmEmitTypeScriptDefinitions>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Worker\Worker.csproj" />
  </ItemGroup>

  <Import Project="..\..\eng\PatchCoreLib.targets" />

</Project>
