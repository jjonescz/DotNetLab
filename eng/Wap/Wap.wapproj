<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <WapProjPath Condition="'$(WapProjPath)'==''">$(MSBuildExtensionsPath)\Microsoft\DesktopBridge\</WapProjPath>
    <DesktopBridgePropsPath>$(WapProjPath)\Microsoft.DesktopBridge.props</DesktopBridgePropsPath>
    <DesktopBridgeTargetsPath>$(WapProjPath)\Microsoft.DesktopBridge.targets</DesktopBridgeTargetsPath>
    <DesktopBridgeAvailable Condition="Exists('$(DesktopBridgePropsPath)') and Exists('$(DesktopBridgeTargetsPath)')">true</DesktopBridgeAvailable>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.Build.NoTargets" Condition="'$(DesktopBridgeAvailable)' != 'true' and '$(RequireDesktopBridge)' != 'true'" />
  <Target Name="Build" Condition="'$(DesktopBridgeAvailable)' != 'true' and '$(RequireDesktopBridge)' == 'true'">
    <Error Text="DesktopBridge MSBuild targets were not found. Expected '$(DesktopBridgePropsPath)' and '$(DesktopBridgeTargetsPath)'." />
  </Target>
  <Import Project="Core.props" Condition="'$(DesktopBridgeAvailable)' == 'true'" />
  <Import Project="Sdk.targets" Sdk="Microsoft.Build.NoTargets" Condition="'$(DesktopBridgeAvailable)' != 'true' and '$(RequireDesktopBridge)' != 'true'" />
</Project>